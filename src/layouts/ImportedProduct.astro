---
import ProductNav from '../components/product/ProductNav.astro';
import ProductFooter from '../components/product/ProductFooter.astro';
import { apps } from '../data/apps';
const { slug, page, content } = Astro.props;
const app = apps.find(a => a.slug === slug)!;
const base = import.meta.env.BASE_URL;
const root = base + 'apps/' + slug + '/';
const isMyth = slug === 'mythcraft';
const isOverview = page === 'overview';
const origin = new URL('https://local.invalid' + root + (isOverview ? '' : page + '/'));
function localUrl(url: string) {
  if (/^(?:[a-z]+:|\/\/|#)/i.test(url)) return url;
  const resolved = new URL(url, origin);
  return resolved.pathname + resolved.search + resolved.hash;
}
// The source content keeps its source-relative asset and support URLs.
const html = content
  .replace(/\b(href|src|poster)="([^"]*)"/g, (_: string, key: string, url: string) => `${key}="${localUrl(url)}"`)
  .replace(/\bsrcset="([^"]*)"/g, (_: string, values: string) => 'srcset="' + values.split(',').map((part: string) => { const [url, ...descriptor] = part.trim().split(/\s+/); return [localUrl(url), ...descriptor].join(' '); }).join(', ') + '"');
const heading = isOverview ? app.name : page[0].toUpperCase() + page.slice(1) + ' — ' + app.name;
const themeColor = isMyth ? '#2f5fbf' : '#ffd84d';
const favicon = isMyth ? root + 'assets/art/app-icon.png' : root + 'favicon.png';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content={themeColor} />
    <title>{heading} — Rob Sansom</title>
    <meta name="description" content={app.summary} />
    <link rel="icon" type="image/png" href={favicon} />
    {!isMyth && <link rel="preload" as="font" type="font/woff2" href={root + 'fonts/bricolage-latin.woff2'} crossorigin />}
    {!isMyth && <link rel="preload" as="font" type="font/woff2" href={root + 'fonts/instrument-latin.woff2'} crossorigin />}
    {isMyth && <link rel="preconnect" href="https://fonts.googleapis.com" />}
    {isMyth && <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />}
    {isMyth && <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lilita+One&family=Nunito:wght@400;600;700;800;900&display=swap" />}
    <link rel="stylesheet" href={root + (isMyth ? 'css/style.css' : 'css/site.css')} />
    {!isMyth && (
      <script is:inline>
        // As in the original site: entrances are opt-in and respect reduced motion.
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion-on');
      </script>
    )}
  </head>
  <body class:list={['studio-import', 'studio-import--' + slug, { 'legal-page': isMyth && !isOverview }]}>
    <a class="studio-skip" href="#main">Skip to content</a>
    <ProductNav slug={slug}>
      {isMyth && isOverview && (
        <label class="studio-lang">
          <span class="visually-hidden">Language</span>
          <select id="lang-select" aria-label="Language">
            <option value="en">English</option>
            <option value="fr">Français</option>
            <option value="de">Deutsch</option>
            <option value="es">Español</option>
            <option value="ja">日本語</option>
          </select>
        </label>
      )}
    </ProductNav>
    <main id="main" class:list={[isMyth && !isOverview ? 'legal' : 'studio-overview']}><Fragment set:html={html} /></main>
    <ProductFooter slug={slug} />
    {isMyth && isOverview && <><script is:inline src={root + 'js/i18n.js'}></script><script is:inline src={root + 'js/main.js'}></script></>}
    {!isMyth && <script is:inline src={root + 'js/site.js'}></script>}
  </body>
</html>
<style is:global>
  /* The originals reserve space for their own fixed headers. The studio nav sits in the flow instead (about 100px tall). */
  .studio-import .legal { padding-top: 64px; }
  .studio-import--your-jobs .hero { min-height: calc(100svh - 100px); padding-top: clamp(2.5rem, 6vw, 4.5rem); }
  .studio-import--mythcraft .hero { min-height: calc(100svh - 100px); }
  .studio-import .scene.page-hero { padding-top: 64px; }
  /* Four books: avoid the original's 3 + 1 orphan at laptop widths. */
  .studio-import--mythcraft .book-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  @media (max-width: 1100px) { .studio-import--mythcraft .book-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .studio-import--mythcraft .book-grid { grid-template-columns: 1fr; } }
  .studio-skip { position: absolute; left: 20px; top: -100px; z-index: 200; background: white; color: black; padding: 12px; }
  .studio-skip:focus { top: 10px; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .studio-lang select { font: 500 14px/1.2 'Instrument Sans', system-ui, sans-serif; color: #111; background: #fff; border: 1px solid #e2e4e8; border-radius: 10px; padding: 8px 12px; cursor: pointer; }
  @media (max-width: 600px) {
    .studio-import--your-jobs .hero, .studio-import--mythcraft .hero { min-height: 0; }
  }
</style>
